// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(uuid())
  phoneNumber       String          @unique
  passwordHash      String
  firstName         String?
  lastName          String?
  registerNumber    String?         @unique
  kycStatus         KycStatus       @default(PENDING)
  signatureImageUrl String?
  membershipLevel   MembershipLevel @default(NORMAL)
  status            UserStatus      @default(ACTIVE)
  isChatBanned      Boolean         @default(false)
  expoPushToken     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  wallet            Wallet?
  purchases         Purchase[]
  sellRequests      SellRequest[]
  chatMessages      ChatMessage[]
  chatThread        ChatThread?
  notifications     Notification[]
  refreshTokens     RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  id                  String              @id @default(uuid())
  userId              String              @unique
  balanceGrams        Decimal             @default(0) @db.Decimal(10, 4)
  totalPurchasedGrams Decimal             @default(0) @db.Decimal(10, 4)
  totalSoldGrams      Decimal             @default(0) @db.Decimal(10, 4)
  updatedAt           DateTime            @updatedAt
  user                User                @relation(fields: [userId], references: [id])
  transactions        WalletTransaction[]
}

model WalletTransaction {
  id            String          @id @default(uuid())
  walletId      String
  userId        String
  type          TransactionType
  amountGrams   Decimal         @db.Decimal(10, 4)
  balanceBefore Decimal         @db.Decimal(10, 4)
  balanceAfter  Decimal         @db.Decimal(10, 4)
  referenceId   String?
  note          String?
  createdAt     DateTime        @default(now())
  wallet        Wallet          @relation(fields: [walletId], references: [id])
}

model Purchase {
  id             String         @id @default(uuid())
  orderNo        String?        @unique
  userId         String
  amountGrams    Decimal        @db.Decimal(10, 4)
  pricePerGram   Decimal        @db.Decimal(15, 2)
  totalAmountMnt Decimal        @db.Decimal(15, 2)
  status         PurchaseStatus @default(PENDING)
  contractPdfUrl String?
  contractQrCode String?
  qpayInvoiceId  String?
  qpayStatus     QpayStatus     @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id])
}

model SellRequest {
  id             String            @id @default(uuid())
  requestNo      String?           @unique
  userId         String
  amountGrams    Decimal           @db.Decimal(10, 4)
  pricePerGram   Decimal?          @db.Decimal(15, 2)
  totalAmountMnt Decimal?          @db.Decimal(15, 2)
  status         SellRequestStatus @default(PENDING)
  adminNote      String?
  processedBy    String?
  approvedAt     DateTime?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id])
}

model GoldPrice {
  id              String     @id @default(uuid())
  pricePerGram    Decimal    @db.Decimal(15, 2)
  mongolBankPrice Decimal    @db.Decimal(15, 2)
  buyPrice        Decimal    @db.Decimal(15, 2)
  sellPrice       Decimal    @db.Decimal(15, 2)
  changePercent   Decimal?   @db.Decimal(8, 4)
  note            String?    @db.Text
  adminId         String?
  source          String     @default("MANUAL")
  createdAt       DateTime   @default(now())
  admin           AdminUser? @relation(fields: [adminId], references: [id])
}

model News {
  id              String     @id @default(uuid())
  title           String
  summary         String?    @db.Text
  content         String     @db.Text
  coverImageUrl   String?
  imageUrls       String[]
  status          NewsStatus @default(DRAFT)
  isPublished     Boolean    @default(false)
  publishedAt     DateTime?
  tags            String[]
  slug            String?    @unique
  metaTitle       String?
  metaDescription String?    @db.Text
  adminId         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  admin           AdminUser? @relation(fields: [adminId], references: [id])
}

model MembershipConfig {
  id        String          @id @default(uuid())
  level     MembershipLevel @unique
  minGrams  Decimal         @db.Decimal(10, 4)
  updatedAt DateTime        @updatedAt
}

model ChatMessage {
  id         String         @id @default(uuid())
  userId     String
  message    String
  senderType ChatSenderType @default(USER)
  adminId    String?
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id])
}

model ChatThread {
  id              String           @id @default(uuid())
  userId          String           @unique
  status          ChatThreadStatus @default(OPEN)
  adminLastReadAt DateTime?
  lastMessageAt   DateTime         @default(now())
  lastMessageText String?
  unreadByAdmin   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  name         String
  role         AdminRole   @default(OPERATOR)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  goldPrices   GoldPrice[]
  newsArticles News[]
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  adminId   String?
  action    String
  entity    String?
  entityId  String?
  ipAddress String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MembershipLevel {
  NORMAL
  BRONZE
  SILVER
  GOLD
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum TransactionType {
  PURCHASE
  SELL_DEDUCT
  ADMIN_ADJUST
}

enum PurchaseStatus {
  PENDING
  CONTRACT_SIGNED
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
}

enum QpayStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum SellRequestStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ChatThreadStatus {
  OPEN
  CLOSED
}

enum ChatSenderType {
  USER
  ADMIN
}
